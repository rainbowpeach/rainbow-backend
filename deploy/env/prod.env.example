APP_ENV=prod
HOST=127.0.0.1
PORT=28081

DB_DRIVER=mysql
DB_DSN=root:password@tcp(127.0.0.1:3306)/rainbow_prod?charset=utf8mb4&parseTime=True&loc=Local
LOG_ROOT=/opt/rainbow-backend/logs/prod

JWT_SECRET=prod_jwt_secret_change_this
JWT_EXPIRES_IN=7200

ADMIN_USERNAME=admin
ADMIN_PASSWORD=prod_admin_password_change_this

ALLOW_ORIGINS=https://admin.example.com

UPLOAD_ROOT=/opt/rainbow-backend/uploads/prod
UPLOAD_IMAGE_MAX_SIZE=52428800
UPLOAD_AUDIO_MAX_SIZE=52428800
UPLOAD_VIDEO_MAX_SIZE=524288000

ENABLE_PUBLIC_SCENE_OVERRIDE=false

WECHAT_MINIPROGRAM_APP_ID=wx_prod_app_id
WECHAT_MINIPROGRAM_APP_SECRET=prod_wechat_app_secret_change_this
WECHAT_JSCODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session
WECHAT_USER_TOKEN_EXPIRES_IN=2592000

ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_MODEL=
ARK_TIMEOUT_SECONDS=60
